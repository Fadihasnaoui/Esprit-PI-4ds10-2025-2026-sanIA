POSTGRES_USER=postgres
POSTGRES_PASSWORD=sania_pass
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=sania_db
DATABASE_URL=postgresql://postgres:sania_pass@db:5432/sania_db

# Security
SECRET_KEY=yoursecretkeyhere

# MinIO / S3 (Storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_IMAGES=sania-drone-images

# AI / RAG
# --- Chat (recommendations): Token Factory (ESPRIT) or OpenAI ---
OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=https://tokenfactory.esprit.tn/api/v1
# LLM_MODEL=hosted_vllm/Llama-3.1-70B-Instruct
LLM_MODEL=gpt-4o-mini

# --- Embeddings (index + search in pgvector) ---
# Option A — ESPRIT Token Factory (same OPENAI_API_KEY + OPENAI_BASE_URL as chat): OpenAI-compatible POST /v1/embeddings
# Set EMBEDDING_MODEL to the embedding model id your gateway serves (same as in Factory / LiteLLM config).
# EMBEDDING_DIMENSION defaults to 1536 for API embeddings; if your model uses another size, set EMBEDDING_DIMENSION explicitly.
EMBEDDING_BACKEND=openai
EMBEDDING_MODEL=text-embedding-3-small
# Option B — FREE local CPU (no Factory embeddings): EMBEDDING_BACKEND=local  LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
# Option C — Chat via Factory but embeddings only on OpenAI: OPENAI_EMBEDDING_API_KEY + OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
# When switching local ↔ API: DROP TABLE knowledge_chunks; then restart and re-ingest.
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional — Hugging Face Hub (sentence-transformers downloads; higher rate limits). Same as: HUGGING_FACE_HUB_TOKEN
# HF_TOKEN=hf_your_read_token_here

# Single file OR leave unset if you only use KNOWLEDGE_DIR_PATH
KNOWLEDGE_FILE_PATH=C:/Users/you/ProjetPi/pdf_text.txt
# Folder: all .pdf, .txt, .md in this directory are indexed (not subfolders). python -m scripts.ingest_rag with no args uses this first.
KNOWLEDGE_DIR_PATH=C:/Users/you/ProjetPi/pdfs

RAG_INGEST_SECRET=change-me

# NDVI provider: eosda (recommended — always free, real Sentinel-2), planetary_stac (open STAC), agromonitoring (legacy)
# Get your EOSDA key at https://api-connect.eos.com → My Account → API Keys
EOSDA_API_KEY=
NDVI_PROVIDER=eosda
NDVI_STAC_LOOKBACK_DAYS=120

# Satellite — must be the exact "appid" from https://agromonitoring.com (logged in) → API KEYS.
# If this key is not from the same account as the web dashboard, polygons and NDVI will not match what you see on the site.
# Test: GET /api/v1/fields/agromonitoring-status (with JWT) → remote_polygon_count
AGROMONITORING_API_KEY=
# false = on API quota (413), do not show fake NDVI (recommended for production)
AGROMONITORING_SIMULATE_ON_QUOTA=false

# IoT Configuration (MQTT)
MQTT_BROKER_URL=mqtt://mosquitto:1883
